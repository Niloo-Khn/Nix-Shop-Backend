{
  "name": "nix-shop-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/unit/*.test.js",
    "test:integration": "npm run build && node --test dist/tests/integration/*.integration.test.js",
    "test:all": "npm run test && npm run test:integration",
    "start:accounts": "SERVICE=accounts node dist/src/main.js",
    "start:products": "SERVICE=products node dist/src/main.js",
    "start:payments": "SERVICE=payments node dist/src/main.js",
    "start:help": "SERVICE=help node dist/src/main.js"
  },
  "devDependencies": { "@types/node": "^24.3.0", "typescript": "^5.9.2" },
  "engines": { "node": ">=20" }
}
